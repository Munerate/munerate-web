# tele.munerate.com demo gate — copy to .env.local (never commit secrets)

# Resend API key. Unset = dev mode: submissions are logged, not emailed.
RESEND_API_KEY=

# Comma-separated IPv4/IPv6 addresses and CIDR ranges that may load the demo.
# Applications arrive by email with a ready-to-paste line for this variable.
TELE_WHITELIST=

# Where access applications are sent (default: munerated@gmail.com).
TELE_NOTIFY_EMAIL=munerated@gmail.com

# Sender for both emails; the domain must be verified in Resend.
TELE_FROM_EMAIL=munerate <access@munerate.com>
